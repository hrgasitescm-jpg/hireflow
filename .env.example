# ============================================================
# Salin file ini menjadi .env.local lalu isi nilainya.
# Ambil semua nilai di: Supabase Dashboard > Project Settings > API
# ============================================================

# URL project Supabase, contoh: https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik (anon / publishable). Aman dikirim ke browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci service role. RAHASIA — hanya dipakai di server.
# JANGAN pernah diberi prefix NEXT_PUBLIC_ dan jangan di-commit ke git.
SUPABASE_SERVICE_ROLE_KEY=

# URL dasar aplikasi (untuk link di email & redirect auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rahasia untuk melindungi endpoint cron (/api/cron/*)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
